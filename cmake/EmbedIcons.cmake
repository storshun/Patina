# Generates a C++ source that embeds every icons/*.svg file (the toolbar icons, src/core/VectorIcon.h).
# Usage: cmake -DOUT=<file.cpp> -DDIR=<icon dir> -P EmbedIcons.cmake
file(GLOB ICONS ${DIR}/*.svg)
list(SORT ICONS)
set(BODY "// Generated by EmbedIcons.cmake - do not edit\n#include \"core/VectorIcon.h\"\nnamespace patina::vicon {\nconst std::vector<Embedded>& embedded() {\n  static const std::vector<Embedded> v = {\n")
foreach(F ${ICONS})
  get_filename_component(NAME ${F} NAME_WE)
  file(READ ${F} SRC)
  string(APPEND BODY "    {\"${NAME}\", R\"PATINA_SVG(${SRC})PATINA_SVG\"},\n")
endforeach()
string(APPEND BODY "  };\n  return v;\n}\n}  // namespace patina::vicon\n")
file(WRITE ${OUT}.tmp "${BODY}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${OUT}.tmp ${OUT})
