# Generates a C++ source that embeds every src/shaders/*.glsl file.
# Usage: cmake -DOUT=<file.cpp> -DDIR=<shader dir> -P EmbedShaders.cmake
file(GLOB SHADERS ${DIR}/*.glsl)
list(SORT SHADERS)
set(BODY "// Generated by EmbedShaders.cmake - do not edit\n#include <string_view>\n#include <unordered_map>\n#include <string>\nnamespace patina::shaders {\nconst std::unordered_map<std::string, std::string_view>& all() {\n  static const std::unordered_map<std::string, std::string_view> m = {\n")
foreach(F ${SHADERS})
  get_filename_component(NAME ${F} NAME)
  file(READ ${F} SRC)
  # raw string delimiter unlikely to appear in GLSL
  string(APPEND BODY "    {\"${NAME}\", R\"PATINA_GLSL(${SRC})PATINA_GLSL\"},\n")
endforeach()
string(APPEND BODY "  };\n  return m;\n}\n}\n")
file(WRITE ${OUT}.tmp "${BODY}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${OUT}.tmp ${OUT})
